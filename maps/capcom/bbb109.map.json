    "platform": "capcom",
    "roms": [
      "bbb109"
    ]
  },
  "game_state": {
    "scores": [
      {
        "label": "Player 1",
        "start": "0x00061F32",
        "encoding": "int",
        "endian": "big",
        "length": 4,
        "_notes": [
          "Verified by real play (two 1-player games recorded 8,033,170 and 110,318,580 live). Players 2-4 were removed: their addresses were an unverified +0x70 stride guess and read uninitialized DRAM garbage during a real 1-player game."
        ]
      }
    ],
    "final_scores_order": "most_recent_first",
    "final_scores": [
      {
        "label": "Recent Game 1 (newest)",
        "_notes": [
          "Recent-games buffer in battery DRAM (.nv file offset 0x205E), newest completed entry first. At game over the machine pushes ONE entry PER PLAYER, last player first: after a real 2-player game (P1 10,241,410 / P2 22,878,190) entry 1 held 22,878,190 (P2) and entry 2 held 10,241,410 (P1). Combined with game_state.player_count N, player i is entry N-i+1 (final_scores_order=most_recent_first). Even-offset big-endian x10, same layout as the high-score table. Also verified with 1-player games 9,355,020 and 110,318,580. Aborted games (slam tilt) and zero-score synthetic games are NOT pushed. This is the final score at game over, NOT the live in-play score (that lives in higher CPU work RAM)."
        ],
        "encoding": "int",
        "endian": "big",
        "scale": 10,
        "offsets": [
          "0x3000205E",
          "0x30002060",
          "0x30002062",
          "0x30002064"
        ]
      },
