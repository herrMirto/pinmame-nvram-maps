    "final_scores": [
      {
        "label": "Recent Game 1 (newest)",
        "_notes": [
          "Recent-games buffer in battery DRAM, newest completed entry first; one push per player at game over, last player first (structure verified on bbb109 with a real 2-player game). player_count for this 1.08 revision has NOT been located yet (bbb109's 0x000620EA reads 0 here), so multi-player attribution stays limited to the newest entry until it is triangulated."
        ],
        "encoding": "int",
        "endian": "big",
        "scale": 10,
