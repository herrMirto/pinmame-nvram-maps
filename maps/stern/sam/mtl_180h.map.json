        "encoding": "int",
        "length": 8
      },
      {
        "label": "Player 4",
        "start": "0x02110A3C",
        "encoding": "int",
        "length": 8
      }
    ],
    "game_over": {
      "_notes": [
        "Validated from real mtl_180h play: 0x02110904 reads 0x80 (ball in play) vs 0xC0 (game over); bit 0x40 set = game over. Confirmed set across Metallica idle NVRAM dumps."
      ],
      "label": "Game Over",
      "start": "0x02110904",
      "encoding": "bool",
      "mask": "0x40"
    },
    "credits": {
      "_notes": [
        "Stern SAM platform-wide credits counter at fixed NVRAM address 0x0211100C (redundant copy at 0x02111014). Identified by the stimulus-response harness (identify_game_state.py): the byte rises as coins are inserted and drops by exactly 1 when a game starts - a pricing-agnostic signature. Confirmed on mtl_180h, trn_174, avs_170, xmn_150."
      ],
      "label": "Credits",
      "start": "0x0211100C",
      "encoding": "int",
      "length": 1
    }
  },
