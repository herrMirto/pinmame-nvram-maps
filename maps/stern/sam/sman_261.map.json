      "Copyright (C) 2026 by Andre Santana <herrmirto@proton.me>"
    ],
    "license": "GNU Lesser General Public License v3.0",
    "platform": "stern-sam",
    "roms": [
      "sman_261"
    ]
  },
  "game_state": {
    "player_count": {
      "_notes": [
        "Stern SAM number-of-players-in-game at fixed NVRAM address 0x02110900 (adjacent to game_over 0x02110904 in the SAM game-state header). Identified from three real played dumps: the only byte that reads exactly 2 / 3 / 4 in 2-, 3- and 4-player games (mtl_180h)."
      ],
      "label": "Player Count",
      "start": "0x02110900",
      "encoding": "int",
      "length": 1
    },
    "scores": [
      {
        "label": "Player 1",
        "start": "0x021109E4",
        "encoding": "int",
        "length": 8
      },
      {
        "label": "Player 2",
        "start": "0x021109EC",
        "encoding": "int",
        "length": 8
      },
      {
        "label": "Player 3",
        "start": "0x021109F4",
        "encoding": "int",
        "length": 8
      },
      {
        "label": "Player 4",
        "start": "0x021109FC",
        "encoding": "int",
        "length": 8
      }
    ],
    "credits": {
      "_notes": [
        "Stern SAM platform-wide credits counter at fixed NVRAM address 0x0211100C (redundant copy at 0x02111014). Identified by the stimulus-response harness (identify_game_state.py): the byte rises as coins are inserted and drops by exactly 1 when a game starts - a pricing-agnostic signature. Confirmed on mtl_180h, trn_174, avs_170, xmn_150."
      ],
      "label": "Credits",
      "start": "0x0211100C",
      "encoding": "int",
      "length": 1
    },
    "_notes": [
      "game_over was removed: the SAM fixed-address flag 0x02110904 bit 0x40 does not apply to the Spider-Man family. Evidence: a real played smanve_101 dump saved at attract after a finished game reads 0x10 (bit 0x40 clear), and the sman_261 idle dump shows the same 0x10 signature, while validated families (mtl/trn/xmn) read the bit set at rest."
    ]
  },
